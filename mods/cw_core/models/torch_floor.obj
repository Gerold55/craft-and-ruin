# torch_floor.obj
# Simple low-poly torch for Luanti/Minetest
o TorchFloor

v 0.0000 -0.5000  0.0000
v 0.0600 -0.5000  0.0000
v 0.0000 -0.5000  0.0600
v -0.0600 -0.5000  0.0000
v 0.0000 -0.5000 -0.0600

v 0.0000  0.2000  0.0000
v 0.0600  0.2000  0.0000
v 0.0000  0.2000  0.0600
v -0.0600  0.2000  0.0000
v 0.0000  0.2000 -0.0600

# Head (slightly thicker)
v 0.0000  0.3000  0.0000
v 0.0800  0.3000  0.0000
v 0.0000  0.3000  0.0800
v -0.0800  0.3000  0.0000
v 0.0000  0.3000 -0.0800

vt 0.50 0.00
vt 1.00 0.00
vt 0.75 0.25
vt 0.50 0.50
vt 1.00 0.50
vt 0.75 0.75
vt 0.50 1.00
vt 1.00 1.00

vn 0  0  1
vn 1  0  0
vn 0  0 -1
vn -1 0  0
vn 0  1  0
vn 0 -1  0

usemtl torch

# Stick sides
f 1/1/1 3/2/1 8/3/1 6/4/1
f 1/1/2 6/4/2 7/5/2 2/6/2
f 2/6/3 7/5/3 10/7/3 5/8/3
f 5/8/4 10/7/4 9/3/4 4/2/4

# Head sides
f 6/1/1 8/2/1 13/3/1 11/4/1
f 6/1/2 11/4/2 12/5/2 7/6/2
f 7/6/3 12/5/3 15/7/3 10/8/3
f 10/8/4 15/7/4 14/3/4 9/2/4

# Top of head
f 11/1/5 13/2/5 15/3/5 14/4/5
